model ImportacaoCertificadoDrake {
  versaoAnterior DrakeCertificadoVersao? @relation("VersaoNova")
  versaoSeguinte DrakeCertificadoVersao? @relation("VersaoAnterior")
  notaCarregamento DrakeCertificadoCarregamentoNota?
  id                       Int                                @id @default(autoincrement())
  usuarioId                Int
  nomeArquivo              String
  hashArquivo              String
  tamanhoArquivoBytes      Int?
  ambiente                 String                             @default("hmg")
  status                   String                             @default("ANALISANDO")
  totalLinhas              Int                                @default(0)
  totalValidas             Int                                @default(0)
  totalErroValidacao       Int                                @default(0)
  totalDuplicadas          Int                                @default(0)
  totalConflitos           Int                                @default(0)
  totalPendentes           Int                                @default(0)
  totalEnviadas            Int                                @default(0)
  totalConfirmadas         Int                                @default(0)
  totalErroDrake           Int                                @default(0)
  totalNaoConfirmadas      Int                                @default(0)
