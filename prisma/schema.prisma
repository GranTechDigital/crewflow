// Auditoria de chamadas ao receptor. Não armazena token; corpos de erro ficam cifrados.
model DrakeDocumentoTentativaRecebimento {
  id String @id @default(uuid()) @db.Uuid
  ambiente String
  rota String
  httpStatus Int
  codigo String
  tamanhoCorpo Int
  hashCorpo String?
  corpoCifrado String?
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  @@index([ambiente, criadoEm], map:"DrakeDocumentoTentativaRecebimento_ambiente_criado_idx")
  @@index([codigo, criadoEm], map:"DrakeDocumentoTentativaRecebimento_codigo_criado_idx")
}

model DrakeCertificadoConfirmacao {
  id String @id @db.Uuid
  itemId Int
  origemId String @db.Uuid
  cargaId String @db.Uuid
  documentoId String? @db.Uuid
  status String
  motivo String
  referenciaEm DateTime @db.Timestamptz(3)
  evidencia Json
  criadoEm DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  @@unique([itemId, cargaId, referenciaEm], map: "DrakeCertConfirmacao_evento_key")
  @@index([itemId, criadoEm(sort: Desc)], map: "DrakeCertConfirmacao_item_idx")
}
