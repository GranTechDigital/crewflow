generator client {
  provider = "prisma-client-js"
}

// no-op whitespace for CI trigger
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Referência local do Drake. Independente dos lotes de envio de certificados.
model DrakeDocumentoOrigem {
  id              String @id @db.Uuid
  ambiente        String
  tenantId        String @db.Uuid
  status          String @default("SEM_CARGA")
  versao          Int @default(0)
  cargaAtivaId    String? @db.Uuid
  atualizadoEm    DateTime? @db.Timestamptz(3)
  cargas          DrakeDocumentoCarga[]
  documentos      DrakeDocumentoReferencia[]
  exclusoes       DrakeDocumentoExclusao[]

  @@unique([ambiente, tenantId])
}

model DrakeDocumentoCarga {
  id              String @id @db.Uuid
  origemId        String @db.Uuid
  nomeArquivo     String
  hashArquivo     String
  parserVersao    String
  fusoFonte       String
  arquivoPrivado  String
  status          String @default("VALIDANDO")
  resumo          Json @default("{}")
  erro            String?
  iniciadoEm      DateTime @default(now()) @db.Timestamptz(3)
  heartbeatEm     DateTime @default(now()) @db.Timestamptz(3)
  concluidoEm     DateTime? @db.Timestamptz(3)
  origem          DrakeDocumentoOrigem @relation(fields: [origemId], references: [id])
  staging         DrakeDocumentoStaging[]
  documentos      DrakeDocumentoReferencia[]
  revisoes        DrakeDocumentoRevisao[]

  @@unique([origemId, hashArquivo, parserVersao])
  @@index([origemId, status])
}

model DrakeDocumentoStaging {
  cargaId         String @db.Uuid
  numeroLinha     Int
  documentoId     String @db.Uuid
  hashDados       String
  dados           Json
  carga           DrakeDocumentoCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@id([cargaId, numeroLinha])
  @@index([cargaId, documentoId])
}

model DrakeDocumentoReferencia {
  origemId                  String @db.Uuid
  documentoId               String @db.Uuid
  matricula                 String
  tipoNormalizado           String
  qualificacaoNormalizada   String
  emissao                   DateTime @db.Date
  alteradoNaFonteEm         DateTime @db.Timestamptz(3)
  hashDados                 String
  dados                     Json
  primeiraCargaId           String @db.Uuid
  ultimaCargaId             String @db.Uuid
  observadoEm               DateTime? @db.Timestamptz(3)
  atualizadoEm              DateTime @default(now()) @db.Timestamptz(3)
  origem                    DrakeDocumentoOrigem @relation(fields: [origemId], references: [id])
  ultimaCarga                DrakeDocumentoCarga @relation(fields: [ultimaCargaId], references: [id])

  @@id([origemId, documentoId])
  @@index([origemId, matricula, tipoNormalizado, qualificacaoNormalizada, emissao], map: "DrakeDocRef_correspondencia_idx")
}

model DrakeDocumentoRevisao {
  id              BigInt @id @default(autoincrement())
  origemId        String @db.Uuid
  documentoId     String @db.Uuid
  cargaId         String @db.Uuid
  dadosAnteriores Json
  dadosNovos      Json
  criadoEm        DateTime @default(now()) @db.Timestamptz(3)
  carga           DrakeDocumentoCarga @relation(fields: [cargaId], references: [id])

  @@index([origemId, documentoId])
}

model DrakeDocumentoConferencia {
  itemId          Int @id
  origemId        String? @db.Uuid
  versao          Int?
  status          String
  motivo          String?
  totalCandidatos Int @default(0)
  candidatos      Json @default("[]")
  conferidoEm     DateTime @db.Timestamptz(3)
  item            ImportacaoCertificadoDrakeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model DrakeDocumentoExclusao {
  id                String @id @db.Uuid
  origemId          String @db.Uuid
  documentoId       String @db.Uuid
  itemId            Int
  usuarioId         Int
  usuarioNome       String
  justificativa     String
  versaoReferencia  Int
  referencia        Json
  payload           Json
  status            String
  httpStatus        Int?
  resposta          Json?
  erro              String?
  iniciadoEm        DateTime @default(now()) @db.Timestamptz(3)
  finalizadoEm      DateTime? @db.Timestamptz(3)
  origem            DrakeDocumentoOrigem @relation(fields: [origemId], references: [id])
  restauracoes      DrakeDocumentoRestauracao[]

  @@index([origemId, documentoId, iniciadoEm], map: "DrakeDocExclusao_documento_idx")
  @@index([itemId])
}

model DrakeDocumentoRestauracao {
  id            String @id @db.Uuid
  exclusaoId    String @db.Uuid
  usuarioId     Int
  usuarioNome   String
  payload       Json
  status        String
  httpStatus    Int?
  resposta      Json?
  erro          String?
  iniciadoEm    DateTime @default(now()) @db.Timestamptz(3)
  finalizadoEm  DateTime? @db.Timestamptz(3)
  exclusao      DrakeDocumentoExclusao @relation(fields: [exclusaoId], references: [id])

  @@index([exclusaoId, iniciadoEm])
}

model Contrato {
  id                    Int                          @id @default(autoincrement())
  numero                String                       @unique
  nome                  String
  cliente               String
  dataInicio            DateTime
  dataFim               DateTime
  status                String
  createdAt             DateTime                     @default(now())
  centrosCusto          ContratosCentrosCusto[]
  funcionarios          Funcionario[]
  remanejamentosDestino SolicitacaoRemanejamento[]   @relation("ContratoDestino")
  remanejamentosOrigem  SolicitacaoRemanejamento[]   @relation("ContratoOrigem")
  funcionariosVinculo   FuncionarioContratoVinculo[]
  matrizTreinamento     MatrizTreinamento[]
}

model CentroCusto {
  id                Int                     @id @default(autoincrement())
  num_centro_custo  String                  @unique
  nome_centro_custo String
  status            String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  contratos         ContratosCentrosCusto[]
}

model ContratosCentrosCusto {
  id            Int         @id @default(autoincrement())
  contratoId    Int
  centroCustoId Int
  createdAt     DateTime    @default(now())
  centroCusto   CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  contrato      Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, centroCustoId])
}

model Funcionario {
  id                        Int                          @id @default(autoincrement())
  matricula                 String                       @unique
  cpf                       String?
  nome                      String
  funcao                    String?
  rg                        String?
  orgaoEmissor              String?
  uf                        String?
  dataNascimento            DateTime?
  dataAdmissao              DateTime?
  dataDemissao              DateTime?
  email                     String?
  telefone                  String?
  centroCusto               String?
  departamento              String?
  status                    String?
  statusPrestserv           String?
  emMigracao                Boolean                      @default(false)
  contratoId                Int?
  funcaoId                  Int?
  criadoEm                  DateTime                     @default(now())
  atualizadoEm              DateTime                     @updatedAt
  excluidoEm                DateTime?
  sispat                    String?
  contrato                  Contrato?                    @relation(fields: [contratoId], references: [id])
  funcaoRef                 Funcao?                      @relation(name: "FuncionarioToFuncao", fields: [funcaoId], references: [id], onDelete: SetNull)
  contratosVinculo          FuncionarioContratoVinculo[]
  periodoUploads            PeriodoUpload[]
  remanejamentosFuncionario RemanejamentoFuncionario[]
  uptimeSheets              UptimeSheet[]
  uptimeUploads             UptimeUpload[]
  usuario                   Usuario?
  capacitacoes              FuncionarioCapacitacao[]
  importacoesCertificadosItens ImportacaoCertificadoDrakeItem[]

  @@index([funcaoId])
}

model FuncionarioContratoVinculo {
  id            Int         @id @default(autoincrement())
  funcionarioId Int
  contratoId    Int
  tipoVinculo   String      @default("ADICIONAL")
  ativo         Boolean     @default(true)
  dataInicio    DateTime    @default(now())
  dataFim       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contrato      Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, contratoId])
  @@index([funcionarioId])
  @@index([contratoId])
  @@index([ativo])
}

model UptimeSheet {
  id               Int         @id @default(autoincrement())
  matricula        String
  dataAdmissao     DateTime?
  dataDemissao     DateTime?
  dataInicio       DateTime?
  dataFim          DateTime?
  totalDias        Int?
  totalDiasPeriodo Int?
  nome             String?
  funcao           String?
  status           String?
  embarcacao       String?
  observacoes      String?
  sispat           String?
  departamento     String?
  centroCusto      String?
  createdAt        DateTime    @default(now())
  periodoFinal     DateTime?
  periodoInicial   DateTime?
  funcionario      Funcionario @relation(fields: [matricula], references: [matricula], onDelete: NoAction)
}

model DowntimeSheet {
  id                 Int      @id @default(autoincrement())
  codProjeto         String?
  nomeProjeto        String?
  uptime             Float?
  downtime           Float?
  agEmbarque         Int?
  percentAgEmbarque  Float?
  cadastro           Int?
  percentCadastro    Float?
  medicina           Int?
  percentMedicina    Float?
  treinamento        Int?
  percentTreinamento Float?
  atestado           Int?
  percentAtestado    Float?
  falta              Int?
  percentFalta       Float?
  demissao           Int?
  percentDemissao    Float?
  dataUpload         DateTime @default(now())
  nomeArquivo        String?
  uploadPor          String?
  createdAt          DateTime @default(now())

  @@map("downtime_sheet")
}

model SolicitacaoRemanejamento {
  id                   Int                        @id @default(autoincrement())
  tipo                 String                     @default("REMANEJAMENTO")
  contratoOrigemId     Int?
  contratoDestinoId    Int?
  justificativa        String?
  status               String                     @default("Pendente")
  prioridade           String                     @default("Normal")
  solicitadoPorId      Int?
  analisadoPor         String?
  aprovadoPorId        Int?
  dataSolicitacao      DateTime                   @default(now())
  dataAnalise          DateTime?
  dataAprovacao        DateTime?
  dataConclusao        DateTime?
  concluidoPorId       Int?
  observacoes          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  atualizadoPorId      Int?
  historico            HistoricoRemanejamento[]
  funcionarios         RemanejamentoFuncionario[]
  contratoDestino      Contrato?                  @relation("ContratoDestino", fields: [contratoDestinoId], references: [id])
  contratoOrigem       Contrato?                  @relation("ContratoOrigem", fields: [contratoOrigemId], references: [id])
  solicitadoPorUsuario Usuario?                   @relation("SolicitacaoSolicitadoPor", fields: [solicitadoPorId], references: [id])
  aprovadoPorUsuario   Usuario?                   @relation("SolicitacaoAprovadoPor", fields: [aprovadoPorId], references: [id])
  concluidoPorUsuario  Usuario?                   @relation("SolicitacaoConcluidoPor", fields: [concluidoPorId], references: [id])
  atualizadoPorUsuario Usuario?                   @relation("SolicitacaoAtualizadoPor", fields: [atualizadoPorId], references: [id])

  @@index([status])
  @@index([dataSolicitacao])
}

model RemanejamentoFuncionario {
  id                       String                               @id @default(cuid())
  solicitacaoId            Int
  funcionarioId            Int
  statusTarefas            String                               @default("APROVAR SOLICITAÇÃO")
  statusPrestserv          String                               @default("PENDENTE")
  statusFuncionario        String                               @default("SEM_CADASTRO")
  dataRascunhoCriado       DateTime?
  dataSubmetido            DateTime?
  dataResposta             DateTime?
  dataAprovado             DateTime?
  dataConcluido            DateTime?
  dataCancelado            DateTime?
  observacoesPrestserv     String?
  createdAt                DateTime                             @default(now())
  updatedAt                DateTime                             @updatedAt
  aprovadoPorId            Int?
  concluidoPorId           Int?
  canceladoPorId           Int?
  observacoesRemanejamento ObservacaoRemanejamentoFuncionario[]
  historico                HistoricoRemanejamento[]
  solicitacao              SolicitacaoRemanejamento             @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  funcionario              Funcionario                          @relation(fields: [funcionarioId], references: [id])
  tarefas                  TarefaRemanejamento[]
  eventosStatus            TarefaStatusEvento[]
  ciclos                   RemanejamentoCiclo[]
  ciclosEventos            RemanejamentoCicloEvento[]
  integracoesEventos       IntegracaoEventoExterno[]
  integracoesOutbox        IntegracaoOutbox[]
  integracoesInbox         IntegracaoInbox[]
  integracoesSessoes       IntegracaoSessao[]
  capacitacoes             FuncionarioCapacitacao[]
  aprovadoPorUsuario       Usuario?                             @relation("RemFuncAprovadoPor", fields: [aprovadoPorId], references: [id])
  concluidoPorUsuario      Usuario?                             @relation("RemFuncConcluidoPor", fields: [concluidoPorId], references: [id])
  canceladoPorUsuario      Usuario?                             @relation("RemFuncCanceladoPor", fields: [canceladoPorId], references: [id])

  @@unique([solicitacaoId, funcionarioId])
  @@index([statusTarefas])
  @@index([statusPrestserv])
  @@index([aprovadoPorId])
  @@index([concluidoPorId])
  @@index([canceladoPorId])
}

model TarefaRemanejamento {
  id                         String                          @id @default(cuid())
  remanejamentoFuncionarioId String
  tarefaPadraoId             Int?
  treinamentoId              Int?
  tipo                       String
  descricao                  String?
  responsavel                String
  status                     String                          @default("PENDENTE")
  prioridade                 String                          @default("Normal")
  dataCriacao                DateTime                        @default(now())
  dataLimite                 DateTime?
  dataConclusao              DateTime?
  observacoes                String?
  dataVencimento             DateTime?
  setorId                    Int?
  setor                      Equipe?                         @relation(name: "TarefaRemanejamentoSetor", fields: [setorId], references: [id])
  historico                  HistoricoRemanejamento[]
  observacoesTarefa          ObservacaoTarefaRemanejamento[]
  remanejamentoFuncionario   RemanejamentoFuncionario        @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  tarefaPadrao               TarefaPadrao?                   @relation(name: "TarefaRemToPadrao", fields: [tarefaPadraoId], references: [id])
  treinamento                Treinamentos?                   @relation(name: "TarefaRemToTreinamento", fields: [treinamentoId], references: [id])
  eventosStatus              TarefaStatusEvento[]
  ciclosEventos              RemanejamentoCicloEvento[]

  @@index([status])
  @@index([responsavel])
  @@index([tarefaPadraoId])
  @@index([treinamentoId])
  @@index([setorId])
}

model TarefaStatusEvento {
  id                         Int      @id @default(autoincrement())
  tarefaId                   String
  remanejamentoFuncionarioId String
  statusAnterior             String?
  statusNovo                 String
  observacoes                String?
  dataEvento                 DateTime @default(now())
  usuarioResponsavelId       Int?

  tarefa                   TarefaRemanejamento      @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  remanejamentoFuncionario RemanejamentoFuncionario @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  usuario                  Usuario?                 @relation(name: "TarefaEventoUsuarioResponsavel", fields: [usuarioResponsavelId], references: [id])

  @@index([tarefaId, dataEvento])
  @@index([remanejamentoFuncionarioId])
  @@index([statusNovo])
}

model ObservacaoTarefaRemanejamento {
  id              Int                 @id @default(autoincrement())
  tarefaId        String
  texto           String
  dataCriacao     DateTime            @default(now())
  dataModificacao DateTime            @updatedAt
  criadoPor       String
  modificadoPor   String
  tarefa          TarefaRemanejamento @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
}

model ObservacaoRemanejamentoFuncionario {
  id                         Int                      @id @default(autoincrement())
  remanejamentoFuncionarioId String
  texto                      String
  dataCriacao                DateTime                 @default(now())
  dataModificacao            DateTime                 @updatedAt
  criadoPor                  String
  modificadoPor              String
  remanejamentoFuncionario   RemanejamentoFuncionario @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)

  @@index([remanejamentoFuncionarioId])
}

model HistoricoRemanejamento {
  id                         Int                        @id @default(autoincrement())
  remanejamentoFuncionarioId String?
  solicitacaoId              Int?
  tarefaId                   String?
  tipoAcao                   String
  entidade                   String
  campoAlterado              String?
  valorAnterior              String?
  valorNovo                  String?
  descricaoAcao              String
  usuarioResponsavel         String
  usuarioResponsavelId       Int?
  equipeId                   Int?
  dataAcao                   DateTime                   @default(now())
  observacoes                String?
  tarefa                     TarefaRemanejamento?       @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  solicitacao                SolicitacaoRemanejamento?  @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  remanejamentoFuncionario   RemanejamentoFuncionario?  @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  usuario                    Usuario?                   @relation(name: "HistoricoUsuarioResponsavel", fields: [usuarioResponsavelId], references: [id])
  equipe                     Equipe?                    @relation(name: "HistoricoEquipeResponsavel", fields: [equipeId], references: [id])
  ciclosEventos              RemanejamentoCicloEvento[]

  @@index([dataAcao])
  @@index([tipoAcao])
  @@index([entidade])
  @@index([usuarioResponsavel])
  @@index([tarefaId])
  @@index([usuarioResponsavelId])
  @@index([remanejamentoFuncionarioId, dataAcao])
  @@index([solicitacaoId, dataAcao])
}

model Usuario {
  id                    Int         @id @default(autoincrement())
  funcionarioId         Int         @unique
  senha                 String
  equipeId              Int
  ativo                 Boolean     @default(true)
  ultimoLogin           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  equipe                Equipe      @relation(fields: [equipeId], references: [id])
  funcionario           Funcionario @relation(fields: [funcionarioId], references: [id])
  emailSecundario       String?
  obrigarAdicionarEmail Boolean     @default(false)
  obrigarTrocaSenha     Boolean     @default(false)

  historicosComoResponsavel HistoricoRemanejamento[]   @relation("HistoricoUsuarioResponsavel")
  solicitacoesCriadas       SolicitacaoRemanejamento[] @relation("SolicitacaoSolicitadoPor")
  aprovadasSolicitacoes     SolicitacaoRemanejamento[] @relation("SolicitacaoAprovadoPor")
  concluidasSolicitacoes    SolicitacaoRemanejamento[] @relation("SolicitacaoConcluidoPor")
  atualizadasSolicitacoes   SolicitacaoRemanejamento[] @relation("SolicitacaoAtualizadoPor")
  aprovadosRemanejamentos   RemanejamentoFuncionario[] @relation("RemFuncAprovadoPor")
  concluidosRemanejamentos  RemanejamentoFuncionario[] @relation("RemFuncConcluidoPor")
  canceladosRemanejamentos  RemanejamentoFuncionario[] @relation("RemFuncCanceladoPor")
  eventosStatusTarefas      TarefaStatusEvento[]       @relation("TarefaEventoUsuarioResponsavel")
  eventosCicloResponsavel   RemanejamentoCicloEvento[] @relation("CicloEventoUsuarioResponsavel")
  importacoesCertificados   ImportacaoCertificadoDrake[]

  @@index([funcionarioId])
  @@index([equipeId])
  @@index([ativo])
}

// Removido: definição duplicada de Equipe

model Equipe {
  id                           Int                      @id @default(autoincrement())
  nome                         String                   @unique
  descricao                    String?
  ativo                        Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  usuarios                     Usuario[]
  historicosEquipe             HistoricoRemanejamento[] @relation("HistoricoEquipeResponsavel")
  tarefasRemanejamentoPorSetor TarefaRemanejamento[]    @relation("TarefaRemanejamentoSetor")
}

model RemanejamentoCiclo {
  id                         String    @id @default(cuid())
  remanejamentoFuncionarioId String
  numeroCiclo                Int
  setor                      String
  status                     String    @default("ABERTO")
  tipoCiclo                  String    @default("ATENDIMENTO_INICIAL")
  tituloCiclo                String?
  descricaoCiclo             String?
  origem                     String    @default("SISTEMA")
  confianca                  String    @default("ALTA")
  inicioAt                   DateTime
  prazoPrevistoAt            DateTime?
  conclusaoAt                DateTime?
  cancelamentoAt             DateTime?
  motivoAbertura             String?
  motivoFechamento           String?
  criadoPorEventoId          Int?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  remanejamentoFuncionario RemanejamentoFuncionario   @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  eventos                  RemanejamentoCicloEvento[]
  integracoesEventos       IntegracaoEventoExterno[]
  integracoesOutbox        IntegracaoOutbox[]

  @@unique([remanejamentoFuncionarioId, numeroCiclo, setor])
  @@index([remanejamentoFuncionarioId])
  @@index([numeroCiclo])
  @@index([setor])
  @@index([status])
  @@index([tipoCiclo])
  @@index([origem])
}

model RemanejamentoCicloEvento {
  id                         Int      @id @default(autoincrement())
  cicloId                    String
  remanejamentoFuncionarioId String
  tipo                       String
  dataEvento                 DateTime @default(now())
  origem                     String   @default("SISTEMA")
  dados                      Json?
  usuarioResponsavelId       Int?
  tarefaId                   String?
  historicoRemanejamentoId   Int?
  createdAt                  DateTime @default(now())

  ciclo                    RemanejamentoCiclo       @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  remanejamentoFuncionario RemanejamentoFuncionario @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  usuario                  Usuario?                 @relation(name: "CicloEventoUsuarioResponsavel", fields: [usuarioResponsavelId], references: [id])
  tarefa                   TarefaRemanejamento?     @relation(fields: [tarefaId], references: [id])
  historicoRemanejamento   HistoricoRemanejamento?  @relation(fields: [historicoRemanejamentoId], references: [id])

  @@index([cicloId, dataEvento])
  @@index([remanejamentoFuncionarioId, dataEvento])
  @@index([tipo])
  @@index([tarefaId])
  @@index([historicoRemanejamentoId])
}

model IntegracaoEventoExterno {
  id                         Int       @id @default(autoincrement())
  provedor                   String
  dominio                    String
  entidade                   String
  direcao                    String    @default("SAIDA")
  acao                       String
  externalId                 String
  status                     String    @default("ABERTO")
  remanejamentoFuncionarioId String?
  cicloId                    String?
  numeroCiclo                Int?
  setor                      String?
  chaveIdempotencia          String
  startAt                    DateTime?
  endPrevistoAt              DateTime?
  endRealAt                  DateTime?
  payload                    Json?
  metadata                   Json?
  ultimoErro                 String?
  ultimaSincronizacaoAt      DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  remanejamentoFuncionario RemanejamentoFuncionario? @relation(fields: [remanejamentoFuncionarioId], references: [id], onDelete: Cascade)
  ciclo                    RemanejamentoCiclo?       @relation(fields: [cicloId], references: [id], onDelete: SetNull)
  outbox                   IntegracaoOutbox[]
  inbox                    IntegracaoInbox[]

  @@unique([provedor, externalId])
  @@unique([chaveIdempotencia])
  @@index([provedor, dominio, entidade])
  @@index([provedor, direcao, status])
  @@index([status])
  @@index([remanejamentoFuncionarioId])
