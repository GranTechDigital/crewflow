  reportKey              String
  name                   String
  email                  String
  active                 Boolean                       @default(true)
  receivesScheduledEmail Boolean                       @default(true)
  canRequestByEmail      Boolean                       @default(false)
  frequency              String                        @default("weekly")
  lastSentAt             DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  agendas                RelatorioAgendaDestinatario[]

  @@unique([reportKey, email])
  @@index([reportKey, active])
  @@index([email])
