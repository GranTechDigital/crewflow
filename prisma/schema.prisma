  id                    Int                                 @id @default(autoincrement())
  importacaoId          Int
  funcionarioId         Int?
  numeroLinha           Int
  matricula             String
  nome                  String?
  certificadora         String?
  qualificacao          String
  qualificacaoNormalizada String
  tipoDocumento         String
  tipoDocumentoNormalizado String
  emissao               DateTime?
  validade              DateTime?
  recebimento           DateTime?
  chaveIdempotencia     String
  status                String                              @default("VALIDO")
  motivoErro            String?
