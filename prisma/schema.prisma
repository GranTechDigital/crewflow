  usuarioNome String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  anterior ImportacaoCertificadoDrake @relation("VersaoAnterior", fields: [anteriorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  nova ImportacaoCertificadoDrake @relation("VersaoNova", fields: [novaId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model DrakeCertificadoCarregamentoNota {
  raizId Int @id
  texto String @default("")
  usuarioId Int
  usuarioNome String
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  raiz ImportacaoCertificadoDrake @relation(fields: [raizId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model DrakeCertificadoItemEdicao {
  id String @id @default(uuid()) @db.Uuid
  itemId Int
  usuarioId Int
  usuarioNome String
  anterior Json
  novo Json
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  item ImportacaoCertificadoDrakeItem @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([itemId, criadoEm], map: "DrakeCertificadoItemEdicao_item_criado_idx")
}


model DrakeDocumentoEntrega {
  id String @id @default(uuid()) @db.Uuid
  ambiente String
  tenantId String @db.Uuid
  hashRecebimento String
  nomeArquivo String
  urlCifrada String
  validoAte DateTime @db.Timestamptz(3)
  geradoEm DateTime? @db.Timestamptz(3)
  janelaInicio DateTime? @db.Timestamptz(3)
  janelaFim DateTime? @db.Timestamptz(3)
  status String @default("PENDENTE")
  tentativas Int @default(0)
  reserva String? @db.Uuid
  heartbeatEm DateTime? @db.Timestamptz(3)
  cargaId String? @db.Uuid
  hashArquivo String?
  proximaTentativaEm DateTime @default(now()) @db.Timestamptz(3)
  erroCodigo String?
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  concluidoEm DateTime? @db.Timestamptz(3)
  @@unique([ambiente,tenantId,hashRecebimento],map:"DrakeDocumentoEntrega_recebimento_key")
  @@index([status,proximaTentativaEm],map:"DrakeDocumentoEntrega_fila_idx")
